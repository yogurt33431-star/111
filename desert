<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>梦幻甜点铺</title>
<style>
  :root{
    --cell: 76px;
    --gap: 10px;
    --cream: #fff8ef;
    --line: #f6ddc6;
    --pink: #ff8fb1;
    --pink-soft: #ffd7e3;
    --mint: #8fd9bb;
    --brown: #7a4f35;
    --brown-soft: #ac8168;
    --gold: #ffb020;
    --shadow: 0 10px 26px rgba(198,146,110,.18);
  }
  *{ box-sizing: border-box; }
  body{
    margin:0; min-height:100vh; color:var(--brown);
    font-family:"PingFang SC","Microsoft YaHei","HarmonyOS Sans SC",system-ui,-apple-system,"Segoe UI","Noto Color Emoji","Segoe UI Emoji",sans-serif;
    background:
      radial-gradient(1000px 520px at 10% -10%, #fff3e2 0%, rgba(255,243,226,0) 60%),
      radial-gradient(900px 520px at 105% 0%, #ffe8f2 0%, rgba(255,232,242,0) 58%),
      radial-gradient(900px 600px at 50% 125%, #e9f7ff 0%, rgba(233,247,255,0) 62%),
      linear-gradient(170deg,#fffaf4,#fff4ea);
    background-attachment: fixed;
    overflow-x: hidden;
    -webkit-user-select:none; user-select:none;
    -webkit-tap-highlight-color: transparent;
  }
  .app{ max-width:1000px; margin:0 auto; padding:14px 16px 26px; }

  /* ---------- 顶栏 ---------- */
  .topbar{
    display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;
    background:rgba(255,255,255,.78); border:2px solid #fff; border-radius:22px;
    padding:10px 16px; box-shadow:var(--shadow);
  }
  .brand{ font-size:20px; font-weight:900; color:#8a5b3d; line-height:1.15; }
  .brand small{ display:block; font-size:11px; font-weight:600; color:var(--brown-soft); margin-top:2px; }
  .stats{ display:flex; align-items:center; justify-content:flex-end; gap:10px; row-gap:8px; flex-wrap:wrap; }
  .chip{
    display:flex; align-items:center; justify-content:center; gap:6px;
    background:linear-gradient(180deg,#fffdf9,#ffefdf); border:2px solid #ffe0c6;
    border-radius:999px; padding:6px 14px; font-weight:900; font-size:15px;
    box-shadow:0 3px 0 #f7dcc4; min-width:104px;
  }
  .chip .v{ font-variant-numeric:tabular-nums; }
  .chip.bump{ animation:bump .35s ease; }
  @keyframes bump{ 50%{ transform:scale(1.12) rotate(-1.5deg); } }
  .icon-btn{
    width:40px; height:40px; border-radius:50%; border:2px solid #ffe0c6; cursor:pointer;
    background:linear-gradient(180deg,#fffdf9,#ffefdf); box-shadow:0 3px 0 #f7dcc4;
    font-size:18px; line-height:1; display:grid; place-items:center; padding:0;
  }
  .icon-btn:active{ transform:translateY(2px); box-shadow:0 1px 0 #f7dcc4; }

  /* ---------- 关卡信息条 ---------- */
  .stagebar{
    display:flex; align-items:center; gap:12px; flex-wrap:wrap;
    margin-top:12px; padding:9px 16px;
    background:rgba(255,255,255,.78); border:2px solid #fff; border-radius:20px; box-shadow:var(--shadow);
  }
  .stage-name{
    font-size:14px; font-weight:900; color:#c2688f; white-space:nowrap;
    background:#fff0f6; border:2px solid #ffdcea; border-radius:999px; padding:3px 12px;
  }
  .stage-goal{ font-size:13px; font-weight:800; color:var(--brown-soft); white-space:nowrap; }
  .goal-track{
    flex:1 1 120px; min-width:80px; height:12px; border-radius:999px; background:#ffe6d6;
    overflow:hidden; box-shadow:inset 0 1px 2px rgba(180,130,100,.15);
  }
  .goal-track > i{
    display:block; height:100%; width:0%; border-radius:999px;
    background:linear-gradient(90deg,#ffd36e,#ffb020); transition:width .35s ease;
  }
  .stagebar.done{ animation:bump .55s ease; }
  body.phase-home .stagebar{ opacity:.55; }
  .link-btn{
    display:block; margin:10px auto 0; padding:0; background:none; border:none; cursor:pointer;
    font-family:inherit; font-size:12px; font-weight:800; color:#b39279;
    text-decoration:underline; text-underline-offset:3px;
  }
  .link-btn:hover{ color:#c2688f; }

  /* ---------- 主区域 ---------- */
  .stage{ display:flex; gap:18px; align-items:flex-start; justify-content:center; margin-top:16px; flex-wrap:wrap; }
  .panel{
    background:rgba(255,255,255,.74); border:2px solid #fff; border-radius:26px;
    padding:14px; box-shadow:var(--shadow);
  }
  .panel-title{ font-size:13px; font-weight:900; letter-spacing:2px; color:var(--brown-soft); margin:0 0 10px 6px; }

  /* 制作台 */
  .board{
    display:grid; grid-template-columns:repeat(5, var(--cell)); grid-auto-rows:var(--cell);
    gap:var(--gap); touch-action:none;
  }
  .cell{
    position:relative; border-radius:18px; border:2px solid var(--line);
    background:linear-gradient(180deg,#fffdf9,#fff2e5);
    box-shadow:inset 0 2px 0 #fff, 0 2px 5px rgba(206,160,120,.12);
    display:grid; place-items:center; transition:box-shadow .15s, transform .15s, border-color .15s;
  }
  .cell.filled{ border-color:#ffe2c9; background:linear-gradient(180deg,#fffefb,#fff6ec); }
  .cell.hover{ border-color:var(--mint); box-shadow:0 0 0 3px rgba(143,217,187,.55), 0 6px 14px rgba(120,190,160,.3); transform:translateY(-2px); }
  .cell.bad{ animation:shake .32s ease; border-color:#ff9a9a; }
  .cell.dragging .tile{ opacity:.25; transform:scale(.85); }
  @keyframes shake{ 0%,100%{transform:translateX(0)} 25%{transform:translateX(-5px)} 75%{transform:translateX(5px)} }

  .tile{
    font-size:calc(var(--cell) * .62); line-height:1; pointer-events:none;
    filter:drop-shadow(0 3px 3px rgba(160,110,70,.22));
    transition:transform .16s ease, opacity .16s ease;
  }
  .tile.pop{ animation:pop .46s cubic-bezier(.3,1.5,.55,1); }
  @keyframes pop{
    0%{ transform:scale(.55) rotate(-12deg); }
    45%{ transform:scale(1.3) rotate(6deg); }
    70%{ transform:scale(.94) rotate(-2deg); }
    100%{ transform:scale(1) rotate(0); }
  }
  .tile.spawn{ animation:spawnIn .36s cubic-bezier(.3,1.6,.6,1); }
  @keyframes spawnIn{ from{ transform:scale(0) rotate(-30deg); opacity:0; } to{ transform:scale(1) rotate(0); opacity:1; } }

  /* 合成链说明 */
  .chain{
    display:flex; align-items:center; gap:6px; justify-content:center; flex-wrap:wrap;
    margin-top:12px; padding:8px 10px; border-radius:16px;
    background:rgba(255,255,255,.7); border:2px dashed #f3dcc6;
    font-size:12px; font-weight:800; color:var(--brown-soft);
  }
  .chain .node{ position:relative; font-size:20px; line-height:1; }
  .chain .node em{
    position:absolute; right:-6px; bottom:-4px; font-style:normal; font-size:10px;
    background:var(--pink); color:#fff; border-radius:999px; padding:0 5px; font-weight:900;
  }
  .chain .arrow{ opacity:.55; }
  .chain b{ color:var(--pink); }

  /* ---------- 订单栏 ---------- */
  .orders{ width:330px; flex:0 0 auto; }
  .order-list{ display:flex; flex-direction:column; gap:12px; }
  .order-card{
    display:flex; gap:10px; align-items:center; padding:12px 12px 12px 10px;
    border-radius:20px; border:2px solid #fbe3ce;
    background:linear-gradient(180deg,#fffdfa,#fff3e8);
    box-shadow:0 6px 14px rgba(200,150,110,.14);
    transition:box-shadow .16s, transform .16s, border-color .16s;
    touch-action:none;
  }
  .order-card.hover{ border-color:var(--mint); box-shadow:0 0 0 3px rgba(143,217,187,.55), 0 10px 20px rgba(120,190,160,.28); transform:translateY(-2px); }
  .order-card.bad{ animation:shake .34s ease; border-color:#ff9a9a; }
  .order-card.urgent{ animation:urgentPulse 1s ease-in-out infinite; }
  @keyframes urgentPulse{ 50%{ box-shadow:0 0 0 3px rgba(255,120,120,.45), 0 6px 14px rgba(220,120,120,.3); } }
  .order-card.done{ animation:cardDone .42s ease forwards; pointer-events:none; }
  @keyframes cardDone{ 0%{transform:scale(1)} 35%{transform:scale(1.05); box-shadow:0 0 0 5px rgba(143,217,187,.6)} 100%{transform:scale(.9); opacity:0} }
  .order-card.in{ animation:cardIn .42s cubic-bezier(.34,1.56,.64,1); }
  @keyframes cardIn{ from{ transform:translateY(-12px) scale(.94); opacity:.1 } to{ transform:none; opacity:1 } }

  .avatar{
    width:52px; height:52px; flex:0 0 auto; border-radius:50%; display:grid; place-items:center;
    font-size:30px; background:linear-gradient(180deg,#fff6ea,#ffe2ee); border:2px solid #fff;
    box-shadow:0 3px 8px rgba(200,150,140,.22);
  }
  .order-body{ flex:1 1 auto; min-width:0; }
  .want{ font-size:13px; font-weight:800; line-height:1.35; overflow-wrap:anywhere; }
  .want .em{ font-size:19px; vertical-align:-3px; }
  .want .pips{ font-size:11px; color:var(--brown-soft); }
  .bar{ height:9px; border-radius:999px; background:#ffe6d6; margin-top:7px; overflow:hidden; box-shadow:inset 0 1px 2px rgba(180,130,100,.15); }
  .bar > i{ display:block; height:100%; width:100%; border-radius:999px; background:linear-gradient(90deg,#8fd9bb,#5fcf9b); }
  .time{ font-size:11px; font-weight:800; color:var(--brown-soft); margin-top:4px; font-variant-numeric:tabular-nums; }
  .time.warn{ color:#e8503a; }
  .reward{
    flex:0 0 auto; align-self:flex-start; font-size:12px; font-weight:900; color:#c07a00;
    background:#fff3d6; border:2px solid #ffe1a8; border-radius:999px; padding:3px 9px; white-space:nowrap;
  }

  /* ---------- 拖拽幽灵 / 飘字 ---------- */
  .ghost{
    position:fixed; left:0; top:0; z-index:1500; pointer-events:none;
    display:grid; place-items:center; line-height:1; opacity:0;
    transform:translate(-50%,-50%) scale(1);
    transition:opacity .12s ease, transform .12s ease;
  }
  .ghost.on{ opacity:.88; transform:translate(-50%,-50%) scale(1.2); filter:drop-shadow(0 10px 12px rgba(120,80,50,.3)); }
  .fx-layer{ position:fixed; inset:0; pointer-events:none; z-index:1600; }
  .float{
    position:fixed; transform:translate(-50%,-50%); font-weight:900; font-size:22px;
    text-shadow:0 2px 0 #fff, 0 0 8px rgba(255,255,255,.9);
    animation:floatUp 1s ease-out forwards; white-space:nowrap;
  }
  .float.coin{ color:#e8950b; }
  .float.score{ color:#ef6f9d; font-size:18px; }
  .float.ok{ color:#3fae86; font-size:16px; }
  @keyframes floatUp{
    0%{ opacity:0; transform:translate(-50%,-50%) scale(.7); }
    18%{ opacity:1; transform:translate(-50%,-75%) scale(1.1); }
    100%{ opacity:0; transform:translate(-50%,-210%) scale(1); }
  }

  /* ---------- 结束遮罩 ---------- */
  .overlay{
    position:fixed; inset:0; z-index:2000; display:none; align-items:center; justify-content:center;
    background:rgba(96,64,48,.35); padding:20px;
  }
  .overlay.show{ display:flex; animation:fadeIn .25s ease; }
  @keyframes fadeIn{ from{opacity:0} to{opacity:1} }
  .overlay .box{
    width:min(340px,100%); text-align:center; padding:26px 22px 22px; border-radius:28px;
    background:linear-gradient(180deg,#fffdf9,#fff1e4); border:3px solid #fff;
    box-shadow:0 24px 50px rgba(120,80,50,.28); animation:cardIn .35s cubic-bezier(.34,1.56,.64,1);
  }
  .overlay h2{ margin:0 0 6px; font-size:22px; color:#8a5b3d; }
  .overlay p{ margin:0 0 16px; font-size:13px; color:var(--brown-soft); font-weight:700; }
  .ov-stats{ display:flex; gap:10px; justify-content:center; margin-bottom:18px; }
  .ov-stats div{
    flex:1; background:#fff6ea; border:2px solid #ffe4cb; border-radius:16px; padding:10px 6px;
  }
  .ov-stats span{ display:block; font-size:11px; color:var(--brown-soft); font-weight:800; }
  .ov-stats b{ font-size:20px; color:#c07a00; font-variant-numeric:tabular-nums; }
  .btn{
    width:100%; border:none; cursor:pointer; padding:14px; border-radius:18px;
    font-size:16px; font-weight:900; color:#fff; font-family:inherit;
    background:linear-gradient(180deg,#ffa4c1,#ff7aa8); box-shadow:0 5px 0 #e96794;
    transition:transform .1s, box-shadow .1s;
  }
  .btn:active{ transform:translateY(4px); box-shadow:0 1px 0 #e96794; }

  .btn.soft{
    background:linear-gradient(180deg,#fffdfa,#ffeedd); color:#c07a00; box-shadow:0 5px 0 #f0d6bd;
  }
  .btn.soft:active{ box-shadow:0 1px 0 #f0d6bd; }
  .btn-row{ display:flex; gap:10px; }

  /* ---------- 梦幻背景装饰 ---------- */
  .bg{ position:fixed; inset:0; z-index:0; overflow:hidden; pointer-events:none; }
  .bg span{
    position:absolute; top:100%; display:block; line-height:1; opacity:0;
    animation-name:drift; animation-timing-function:linear; animation-iteration-count:infinite;
    filter:drop-shadow(0 4px 8px rgba(220,170,190,.35));
  }
  @keyframes drift{
    0%{ transform:translateY(14vh) rotate(-6deg) scale(.85); opacity:0; }
    12%{ opacity:.72; }
    85%{ opacity:.52; }
    100%{ transform:translateY(-112vh) rotate(22deg) scale(1.1); opacity:0; }
  }
  .app{ position:relative; z-index:1; }
  body.phase-home .stage{ filter:blur(4px) saturate(.9); opacity:.55; }
  body.phase-home .topbar{ opacity:.55; }

  /* ---------- 爱心 / 负分 ---------- */
  .chip.hearts{ min-width:104px; gap:2px; font-size:15px; padding:6px 12px; }
  .heart{ display:inline-block; line-height:1; transition:filter .25s ease, opacity .25s ease; }
  .heart.lost{ filter:grayscale(1); opacity:.45; }
  .heart.heartPop{ animation:heartPop .6s cubic-bezier(.3,1.6,.6,1); }
  @keyframes heartPop{
    0%{ transform:scale(1); } 30%{ transform:scale(1.6) rotate(-14deg); }
    65%{ transform:scale(.88); } 100%{ transform:scale(1); }
  }
  .chip.neg{ color:#d8453a; border-color:#ffd2cb; background:linear-gradient(180deg,#fffafa,#ffefe9); }
  .float.penalty{ color:#e0433a; font-size:20px; }
  .float.penalty.small{ font-size:15px; }
  .order-card.expired{ animation:expireFlash .62s ease; border-color:#ffb0a6; }
  @keyframes expireFlash{
    0%{ transform:translateX(0); } 18%{ transform:translateX(-7px); box-shadow:0 0 0 4px rgba(255,110,110,.5); }
    45%{ transform:translateX(6px); } 75%{ transform:translateX(-3px); } 100%{ transform:translateX(0); }
  }

  /* ---------- 开始界面 ---------- */
  .screen{
    position:fixed; inset:0; z-index:1800; display:none; align-items:center; justify-content:center;
    padding:18px; overflow:auto;
    background:linear-gradient(180deg, rgba(255,250,245,.48), rgba(255,235,246,.56) 55%, rgba(228,244,255,.62));
    -webkit-backdrop-filter:blur(3px); backdrop-filter:blur(3px);
  }
  .screen.show{ display:flex; animation:fadeIn .3s ease; }
  .home-card{
    width:min(560px,100%); max-height:100%; overflow:auto; margin:auto; text-align:center;
    background:rgba(255,255,255,.9); border:3px solid #fff; border-radius:30px; padding:24px 22px 20px;
    box-shadow:0 26px 60px rgba(170,120,90,.22);
    animation:cardIn .45s cubic-bezier(.34,1.56,.64,1);
  }
  .home-badge{
    display:inline-block; font-size:11px; font-weight:900; letter-spacing:2px; color:#c08a6a;
    background:#fff5ea; border:2px solid #ffe6d2; border-radius:999px; padding:4px 12px;
  }
  .home-title{
    margin:10px 0 8px; font-size:30px; letter-spacing:3px; color:#8a5b3d;
    text-shadow:0 2px 0 #fff, 0 8px 18px rgba(255,150,190,.5);
  }
  .home-story{ margin:0 auto 16px; max-width:450px; font-size:13px; line-height:1.9; color:#a2795f; font-weight:600; }
  .home-story em{ font-style:normal; color:#e0679a; font-weight:900; }
  .rules{
    text-align:left; background:linear-gradient(180deg,#fffdfa,#fff4ea);
    border:2px solid #ffe7d3; border-radius:20px; padding:12px 14px;
  }
  .rules-title{ font-size:13px; font-weight:900; color:#c08a6a; letter-spacing:1px; margin-bottom:9px; }
  .rules ul{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:8px; }
  .rules li{ display:flex; gap:8px; align-items:flex-start; font-size:12.5px; line-height:1.62; color:#8b6a54; }
  .rules li b{ flex:0 0 62px; color:#c2688f; font-size:12.5px; white-space:nowrap; }
  .rules li span{ flex:1 1 auto; }
  .rules em{ font-style:normal; color:#e0679a; font-weight:900; }
  .rules .nowrap{ white-space:nowrap; }
  .home-foot{ margin-top:12px; font-size:11px; font-weight:700; line-height:1.6; color:#b39279; }
  .home-card .btn{ margin-top:16px; }

  /* ---------- 自适应 ---------- */
  @media (max-width: 900px){
    :root{ --cell:68px; --gap:9px; }
    .orders{ width:100%; max-width:430px; }
    .stage{ gap:14px; }
  }
  @media (max-width: 520px){
    :root{ --cell:58px; --gap:7px; }
    .app{ padding:10px 10px 20px; }
    .brand{ font-size:17px; }
    .chip{ min-width:88px; font-size:14px; padding:5px 10px; }
    .panel{ padding:10px; border-radius:20px; }
    .avatar{ width:44px; height:44px; font-size:25px; }
  }
  @media (max-width: 420px){
    :root{ --cell:52px; --gap:6px; }
    .avatar{ width:40px; height:40px; font-size:22px; }
    .cell{ border-radius:14px; }
  }
  @media (max-width: 560px){
    .brand{ font-size:15px; }
    .brand small{ font-size:10px; }
    .chip, .chip.hearts{ min-width:74px; font-size:13px; padding:5px 8px; gap:4px; }
    .icon-btn{ width:34px; height:34px; font-size:16px; }
  }
  @media (max-width: 360px){
    :root{ --cell:46px; --gap:5px; }
    .app{ padding:8px 8px 16px; }
    .panel{ padding:8px; }
    .want{ font-size:12px; }
    .chip, .chip.hearts{ min-width:66px; font-size:12px; padding:4px 7px; }
    .chip.hearts{ font-size:13px; padding:4px 6px; }
    .icon-btn{ width:30px; height:30px; font-size:14px; }
  }
</style>
</head>
<body class="phase-home">
  <div class="bg" id="bgDeco"></div>

  <div class="app">
    <header class="topbar">
      <div class="brand">🍰 梦幻甜点铺<small>拖拽合成 · 交付订单</small></div>
      <div class="stats">
        <div class="chip hearts" id="heartsChip">❤️❤️❤️</div>
        <div class="chip" id="coinChip">🪙<span class="v" id="coinVal">0</span></div>
        <div class="chip" id="scoreChip">⭐<span class="v" id="scoreVal">0</span></div>
        <button class="icon-btn" id="pauseBtn" title="暂停">⏸️</button>
        <button class="icon-btn" id="soundBtn" title="音效开关">🔊</button>
      </div>
    </header>

    <div class="stagebar" id="stageBar">
      <div class="stage-name" id="stageName">第 1 关</div>
      <div class="stage-goal" id="stageGoal">🎯 完成订单 0/4</div>
      <div class="goal-track"><i id="goalBar"></i></div>
    </div>

    <main class="stage">
      <section class="panel">
        <div class="panel-title">制作台</div>
        <div class="board" id="board"></div>
        <div class="chain" id="chain"><b>合成链</b></div>
      </section>

      <aside class="panel orders">
        <div class="panel-title">顾客订单</div>
        <div class="order-list" id="orderList"></div>
      </aside>
    </main>
  </div>

  <div class="ghost" id="ghost"></div>
  <div class="fx-layer" id="fxLayer"></div>

  <div class="overlay" id="overlay">
    <div class="box">
      <h2>🌙 甜点铺打烊啦</h2>
      <p id="overMsg">爱心用完啦，先歇一歇再试试这一关吧～</p>
      <div class="ov-stats">
        <div><span>🏁 关卡</span><b id="ovStage">1</b></div>
        <div><span>📦 订单</span><b id="ovOrders">0</b></div>
        <div><span>🪙 金币</span><b id="ovCoins">0</b></div>
        <div><span>⭐ 分数</span><b id="ovScore">0</b></div>
      </div>
      <div class="btn-row">
        <button class="btn" id="homeBtn">回到首页 🏠</button>
        <button class="btn" id="retryBtn">重试本关 🔄</button>
      </div>
    </div>
  </div>

  <div class="overlay" id="clearScreen">
    <div class="box">
      <h2 id="clearTitle">🎉 第 1 关完成！</h2>
      <p id="clearMsg">顾客们都心满意足地捧着甜点回家啦～</p>
      <div class="ov-stats">
        <div><span>📦 订单</span><b id="clearOrders">0</b></div>
        <div><span>⭐ 本关得分</span><b id="clearScore">0</b></div>
        <div><span>❤️ 剩余爱心</span><b id="clearHearts">0</b></div>
      </div>
      <div class="btn-row">
        <button class="btn soft" id="clearHomeBtn">回到首页 🏠</button>
        <button class="btn" id="nextBtn">进入第 2 关 ▶</button>
      </div>
    </div>
  </div>

  <div class="overlay" id="pauseScreen">
    <div class="box">
      <h2>☕ 暂停一下</h2>
      <p>烤箱还开着火，随时可以继续营业～</p>
      <div class="ov-stats">
        <div><span>🏁 关卡</span><b id="pauseStage">1</b></div>
        <div><span>📦 订单</span><b id="pauseOrders">0</b></div>
        <div><span>⭐ 分数</span><b id="pauseScore">0</b></div>
      </div>
      <div class="btn-row">
        <button class="btn soft" id="pauseHomeBtn">回到首页 🏠</button>
        <button class="btn" id="resumeBtn">继续营业 ▶</button>
      </div>
    </div>
  </div>

  <div class="screen show" id="home">
    <div class="home-card">
      <div class="home-badge">✦ 云朵甜品小镇 ✦</div>
      <h1 class="home-title">梦幻甜点铺</h1>
      <p class="home-story">
        在云朵和棉花糖交界的地方，有一间只在天色最甜的时候才亮灯的甜点铺。<br />
        当草莓色的晚霞落进烤箱，两份相同的甜点轻轻叠在一起，就会悄悄变成<em>更精致的模样</em>。<br />
        今晚，小镇的居民在云下排起了长队，等你端出第一份甜蜜魔法。
      </p>
      <div class="rules">
        <div class="rules-title">🌙 怎么玩</div>
        <ul>
          <li><b>🍞 合成</b><span>把两个<em>相同</em>的甜点拖到一起，就会升级成更精致的样子：🍞 → 🥐 → 🧁 → 🍰 → 🎂 → 🍮，一共 6 级</span></li>
          <li><b>📦 交付</b><span>把甜点拖到右侧顾客订单上，符合要求就能赚到金币和分数</span></li>
          <li><b>🏁 关卡</b><span>每关都有<em>订单目标</em>，顶部进度条攒满就过关；关卡越靠后订单时间越短</span></li>
          <li><b>⏳ 限时</b><span>订单超时不会立刻结束，但会<em>扣分</em>并失去一颗爱心</span></li>
          <li><b>❤️ 打烊</b><span>爱心用完就打烊，可以重试本关，也可以回到首页</span></li>
          <li><b>✨ 供应</b><span>制作台会不停自动补货，关卡越高补货越快；拖到空位是搬运，拖到同款是合成</span></li>
        </ul>
      </div>
      <button class="btn" id="startBtn">开始营业 🍰</button>
      <button class="link-btn" id="restartRunBtn">↺ 从第 1 关重新开始</button>
      <div class="home-foot">共 <b id="stageCount">8</b> 关 · 🖱️ 鼠标拖拽 / 📱 手指触摸都能玩 · 右上角 ⏸️ 可随时暂停</div>
    </div>
  </div>

<script>
(function(){
  'use strict';

  /* ================= 配置 ================= */
  const COLS = 5, ROWS = 6, TOTAL = COLS * ROWS;

  // 甜点合成链：从朴素到华丽，改这里就能增删品种
  const CHAIN = [
    { emoji:'🍞', name:'吐司',     coins:10  },
    { emoji:'🥐', name:'可颂',     coins:22  },
    { emoji:'🧁', name:'纸杯蛋糕', coins:45  },
    { emoji:'🍰', name:'切片蛋糕', coins:80  },
    { emoji:'🎂', name:'生日蛋糕', coins:130 },
    { emoji:'🍮', name:'豪华布丁', coins:200 }
  ];
  const MAX_LV = CHAIN.length;

  // 关卡表：目标订单数 / 订单时限 / 爱心 / 补货间隔ms / 可点单最高等级 / 补货最高等级
  const STAGES = [
    { goal:4,  time:32000, hearts:4, spawn:1500, maxLv:3, spawnTop:1 },
    { goal:5,  time:30000, hearts:4, spawn:1450, maxLv:4, spawnTop:1 },
    { goal:6,  time:29000, hearts:4, spawn:1400, maxLv:4, spawnTop:2 },
    { goal:7,  time:28000, hearts:3, spawn:1350, maxLv:5, spawnTop:2 },
    { goal:8,  time:26000, hearts:3, spawn:1300, maxLv:5, spawnTop:2 },
    { goal:10, time:25000, hearts:3, spawn:1250, maxLv:6, spawnTop:2 },
    { goal:12, time:23000, hearts:3, spawn:1200, maxLv:6, spawnTop:3 },
    { goal:14, time:21000, hearts:3, spawn:1150, maxLv:6, spawnTop:3 }
  ];
  const START_ITEMS = 12;                        // 开局铺在台面上的甜点数
  const ORDER_START_DELAYS = [0, 6000, 12000];   // 开局 3 张订单错峰到期
  const PENALTY_PER_LV = 12;                     // 超时扣分 = 12 × 等级 × 需求数量
  const AVATARS = ['👩‍🦰','👨‍🦱','👩','🧑‍🦳','👧','👦','🧑‍🦰','👵','👴','🧕','👨‍🦳','👩‍🦱'];
  const DECO_EMOJI = ['☁️','✨','🧁','🍬','🎀','⭐','🌸','💗','🌙','🍓'];
  const STORE_KEY = 'dessert-shop-unlocked-stage';

  const $ = function(id){ return document.getElementById(id); };
  const boardEl = $('board'), ghostEl = $('ghost'), fxEl = $('fxLayer');
  const orderListEl = $('orderList'), overlayEl = $('overlay');
  const coinValEl = $('coinVal'), scoreValEl = $('scoreVal');
  const coinChipEl = $('coinChip'), scoreChipEl = $('scoreChip');
  const soundBtn = $('soundBtn'), pauseBtn = $('pauseBtn');
  const homeEl = $('home'), bgEl = $('bgDeco'), chainEl = $('chain');
  const heartsChipEl = $('heartsChip');
  const stageNameEl = $('stageName'), stageGoalEl = $('stageGoal');
  const goalBarEl = $('goalBar'), stageBarEl = $('stageBar');
  const clearScreenEl = $('clearScreen'), pauseScreenEl = $('pauseScreen');

  /* ================= 状态 ================= */
  let phase = 'home';          // home 首页 / play 营业中 / paused 暂停 / stageClear 过关 / over 打烊
  let stageIndex = 0;
  let unlockedStage = loadUnlocked();
  let cells = new Array(TOTAL).fill(0);   // 0 = 空，1~6 = 甜点等级
  let cellEls = [], heartEls = [];
  let orders = [];
  let coins = 0, score = 0, hearts = 0;
  let stageOrders = 0, totalOrders = 0, stageStartScore = 0, stageStartCoins = 0;
  let rafId = 0, lastSpawn = 0, orderSeq = 0, gameId = 0, pausedAt = 0;
  let drag = null;

  function stage(){ return STAGES[Math.min(stageIndex, STAGES.length - 1)]; }
  function isLastStage(){ return stageIndex >= STAGES.length - 1; }
  function loadUnlocked(){
    try {
      const v = parseInt(window.localStorage.getItem(STORE_KEY), 10);
      if (v >= 1) return Math.min(v, STAGES.length);
    } catch(e){}
    return 1;
  }
  function saveUnlocked(v){
    try { window.localStorage.setItem(STORE_KEY, String(v)); } catch(e){}
  }

  /* ================= 音效（WebAudio 合成，无需外部文件） ================= */
  let actx = null, soundOn = true;
  function audio(){
    if (!soundOn) return null;
    if (!actx) { try { actx = new (window.AudioContext || window.webkitAudioContext)(); } catch(e){ actx = null; } }
    if (actx && actx.state === 'suspended') actx.resume();
    return actx;
  }
  function tone(freq, dur, delay, type, vol){
    const ctx = audio(); if (!ctx) return;
    const t0 = ctx.currentTime + (delay || 0);
    const osc = ctx.createOscillator(), gain = ctx.createGain();
    osc.type = type || 'sine';
    osc.frequency.setValueAtTime(freq, t0);
    gain.gain.setValueAtTime(0.0001, t0);
    gain.gain.linearRampToValueAtTime(vol || 0.07, t0 + 0.012);
    gain.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
    osc.connect(gain); gain.connect(ctx.destination);
    osc.start(t0); osc.stop(t0 + dur + 0.03);
  }
  const sfx = {
    merge: function(lv){ tone(520 + lv * 80, 0.12, 0, 'sine', 0.07); tone(780 + lv * 100, 0.16, 0.08, 'sine', 0.06); },
    pick:  function(){ tone(680, 0.07, 0, 'sine', 0.05); },
    deliver: function(){ tone(600, 0.09, 0, 'triangle', 0.06); },
    done:  function(){ tone(660, 0.12, 0, 'sine', 0.07); tone(880, 0.13, 0.09, 'sine', 0.07); tone(1180, 0.2, 0.18, 'sine', 0.06); },
    bad:   function(){ tone(190, 0.16, 0, 'square', 0.05); },
    expire:function(){ tone(320, 0.16, 0, 'triangle', 0.07); tone(215, 0.28, 0.13, 'triangle', 0.06); },
    clear: function(){ tone(660, 0.12, 0, 'sine', 0.07); tone(880, 0.13, 0.1, 'sine', 0.07); tone(1050, 0.14, 0.2, 'sine', 0.07); tone(1320, 0.26, 0.3, 'sine', 0.06); },
    over:  function(){ tone(520, 0.2, 0, 'sine', 0.07); tone(400, 0.22, 0.16, 'sine', 0.07); tone(280, 0.4, 0.32, 'sine', 0.07); }
  };
  soundBtn.addEventListener('click', function(){
    soundOn = !soundOn;
    soundBtn.textContent = soundOn ? '🔊' : '🔈';
    if (soundOn) sfx.pick();
  });

  /* ================= 工具 ================= */
  function levelInfo(lv){ return CHAIN[lv - 1]; }
  function rewardOf(o){ return levelInfo(o.level).coins * o.need; }
  function randInt(n){ return Math.floor(Math.random() * n); }

  function floatText(x, y, text, cls){
    const el = document.createElement('div');
    el.className = 'float ' + (cls || '');
    el.textContent = text;
    el.style.left = x + 'px';
    el.style.top = y + 'px';
    fxEl.appendChild(el);
    setTimeout(function(){ el.remove(); }, 1000);
  }
  function centerOf(el){
    const r = el.getBoundingClientRect();
    return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
  }
  function bump(el){
    el.classList.remove('bump');
    void el.offsetWidth;
    el.classList.add('bump');
  }
  function updateHUD(){
    coinValEl.textContent = coins;
    scoreValEl.textContent = score;
    scoreChipEl.classList.toggle('neg', score < 0);
  }
  function updateStageBar(){
    const st = stage();
    const done = Math.min(stageOrders, st.goal);
    stageNameEl.textContent = '第 ' + (stageIndex + 1) + ' 关';
    stageGoalEl.textContent = '🎯 完成订单 ' + done + '/' + st.goal;
    goalBarEl.style.width = Math.min(100, (done / st.goal) * 100).toFixed(1) + '%';
  }
  function renderHearts(popIndex){
    for (let i = 0; i < heartEls.length; i++){
      heartEls[i].textContent = i < hearts ? '❤️' : '🖤';
      heartEls[i].classList.toggle('lost', i >= hearts);
    }
    if (typeof popIndex === 'number' && heartEls[popIndex]){
      const el = heartEls[popIndex];
      el.classList.remove('heartPop');
      void el.offsetWidth;
      el.classList.add('heartPop');
    }
  }
  function buildHearts(count){
    heartsChipEl.textContent = '';
    heartEls = [];
    for (let i = 0; i < count; i++){
      const s = document.createElement('span');
      s.className = 'heart';
      heartsChipEl.appendChild(s);
      heartEls.push(s);
    }
    renderHearts();
  }
  function buildChain(){
    chainEl.innerHTML = '<b>合成链</b>';
    CHAIN.forEach(function(c, i){
      if (i){
        const a = document.createElement('span');
        a.className = 'arrow';
        a.textContent = '→';
        chainEl.appendChild(a);
      }
      const n = document.createElement('span');
      n.className = 'node';
      n.title = c.name;
      n.innerHTML = c.emoji + '<em>' + (i + 1) + '</em>';
      chainEl.appendChild(n);
    });
  }
  function buildDeco(){
    for (let i = 0; i < 16; i++){
      const s = document.createElement('span');
      s.textContent = DECO_EMOJI[i % DECO_EMOJI.length];
      s.style.left = (Math.random() * 96).toFixed(1) + '%';
      s.style.fontSize = Math.round(16 + Math.random() * 22) + 'px';
      s.style.animationDuration = (17 + Math.random() * 17).toFixed(1) + 's';
      s.style.animationDelay = (-Math.random() * 34).toFixed(1) + 's';
      bgEl.appendChild(s);
    }
  }
  function hideScreens(){
    overlayEl.classList.remove('show');
    clearScreenEl.classList.remove('show');
    pauseScreenEl.classList.remove('show');
    homeEl.classList.remove('show');
  }
  function updateHomeUI(){
    $('startBtn').textContent = unlockedStage > 1 ? ('继续第 ' + unlockedStage + ' 关 🍰') : '开始营业 🍰';
    $('restartRunBtn').style.display = unlockedStage > 1 ? 'block' : 'none';
    $('stageCount').textContent = STAGES.length;
  }

  /* ================= 制作台 ================= */
  function buildBoard(){
    boardEl.innerHTML = '';
    cellEls = [];
    for (let i = 0; i < TOTAL; i++){
      const cell = document.createElement('div');
      cell.className = 'cell';
      cell.dataset.index = i;
      const tile = document.createElement('div');
      tile.className = 'tile';
      cell.appendChild(tile);
      boardEl.appendChild(cell);
      cellEls.push(cell);
    }
  }
  function renderCell(i, anim){
    const cell = cellEls[i];
    const tile = cell.firstElementChild;
    const lv = cells[i];
    cell.classList.toggle('filled', lv > 0);
    tile.className = 'tile';
    tile.textContent = '';
    tile.removeAttribute('title');
    if (lv > 0){
      tile.textContent = levelInfo(lv).emoji;
      tile.title = levelInfo(lv).name;
      if (anim){
        void tile.offsetWidth;
        tile.classList.add(anim);
      }
    }
  }
  function emptyIndexes(){
    const list = [];
    for (let i = 0; i < TOTAL; i++) if (cells[i] === 0) list.push(i);
    return list;
  }
  function spawnLevel(){
    const top = stage().spawnTop, r = Math.random();
    if (top >= 3 && r < 0.08) return 3;
    if (top >= 2 && r < 0.32) return 2;
    return 1;
  }
  function spawnItem(anim){
    const empties = emptyIndexes();
    if (!empties.length) return false;
    const idx = empties[randInt(empties.length)];
    cells[idx] = spawnLevel();
    renderCell(idx, anim === false ? null : 'spawn');
    return true;
  }

  /* ================= 订单 ================= */
  // 订单只会点台面上「够得着」的等级：唯一一件的高级甜点不会被索取
  function pickOrderLevel(){
    const cap = stage().maxLv;
    const counts = {};
    for (let i = 0; i < TOTAL; i++){
      const lv = cells[i];
      if (lv > 0 && lv <= cap) counts[lv] = (counts[lv] || 0) + 1;
    }
    const pool = [];
    Object.keys(counts).forEach(function(k){
      const lv = Number(k), n = counts[k];
      if (lv > 1 && n < 2) return;
      const w = Math.max(1, Math.round(n / lv));
      for (let i = 0; i < w; i++) pool.push(lv);
    });
    if (!pool.length) pool.push(1);
    return pool[randInt(pool.length)];
  }
  function createOrderEl(){
    const el = document.createElement('div');
    el.className = 'order-card in';
    el.innerHTML =
      '<div class="avatar"></div>' +
      '<div class="order-body">' +
        '<div class="want"></div>' +
        '<div class="bar"><i></i></div>' +
        '<div class="time"><span class="secs"></span></div>' +
      '</div>' +
      '<div class="reward">🪙 <b></b></div>';
    return el;
  }
  function fillOrder(o, delayMs){
    o.dead = false;
    o.level = pickOrderLevel();
    o.need = (o.level <= 2 && Math.random() < 0.25) ? 2 : 1;
    o.got = 0;
    o.avatar = AVATARS[randInt(AVATARS.length)];
    const span = stage().time + (delayMs || 0);
    o.deadline = performance.now() + span;
    o.total = span;
    o.id = 'o' + (++orderSeq);
    o.el.dataset.id = o.id;
    o.avatarEl.textContent = o.avatar;
    o.wantEl.textContent = '';
    const info = levelInfo(o.level);
    o.wantEl.append('需要 ' + o.need + ' 个 ');
    const em = document.createElement('span');
    em.className = 'em';
    em.textContent = info.emoji;
    o.wantEl.append(em, ' ' + info.name);
    if (o.need > 1){
      const pips = document.createElement('span');
      pips.className = 'pips';
      pips.textContent = ' （已交 ' + o.got + '/' + o.need + '）';
      o.pipsEl = pips;
      o.wantEl.append(pips);
    } else {
      o.pipsEl = null;
    }
    o.rewardEl.textContent = rewardOf(o);
    o.barEl.style.width = '100%';
    o.secsEl.textContent = Math.round(span / 1000) + 's';
    o.timeEl.classList.remove('warn');
    o.el.classList.remove('urgent', 'hover');
  }
  function newOrder(delayMs){
    const el = createOrderEl();
    const o = {
      el: el,
      avatarEl: el.querySelector('.avatar'),
      wantEl: el.querySelector('.want'),
      barEl: el.querySelector('.bar > i'),
      timeEl: el.querySelector('.time'),
      secsEl: el.querySelector('.secs'),
      rewardEl: el.querySelector('.reward > b'),
      pipsEl: null
    };
    fillOrder(o, delayMs);
    orderListEl.appendChild(el);
    orders.push(o);
    setTimeout(function(){ el.classList.remove('in'); }, 450);
    return o;
  }
  function updateOrders(now){
    for (let k = 0; k < orders.length; k++){
      const o = orders[k];
      if (o.dead) continue;
      const left = o.deadline - now;
      const ratio = Math.max(0, Math.min(1, left / o.total));
      o.barEl.style.width = (ratio * 100).toFixed(1) + '%';
      const hue = Math.round(132 * ratio);               // 132(绿) -> 0(红)
      o.barEl.style.background = 'linear-gradient(90deg, hsl(' + hue + ' 78% 64%), hsl(' + (hue + 10) + ' 85% 52%))';
      o.secsEl.textContent = '⏳ ' + Math.max(0, Math.ceil(left / 1000)) + 's';
      const warn = ratio <= 0.34;
      o.timeEl.classList.toggle('warn', warn);
      o.el.classList.toggle('urgent', warn);
      if (left <= 0){ expireOrder(o); return; }
    }
  }

  /* ================= 合成 / 交付 / 超时 ================= */
  function mergeInto(from, to){
    const lv = cells[from];
    cells[from] = 0;
    cells[to] = lv + 1;
    renderCell(from);
    renderCell(to, 'pop');
    const pts = (lv + 1) * 3;
    score += pts;
    updateHUD();
    const c = centerOf(cellEls[to]);
    floatText(c.x, c.y, '+' + pts, 'score');
    sfx.merge(lv + 1);
  }
  function badCell(el){
    el.classList.remove('bad');
    void el.offsetWidth;
    el.classList.add('bad');
    setTimeout(function(){ el.classList.remove('bad'); }, 340);
    sfx.bad();
  }
  function tryDeliver(d, cardEl){
    const o = orders.find(function(x){ return x.id === cardEl.dataset.id; });
    if (!o || o.dead || phase !== 'play') return;
    if (d.lv !== o.level){ badCell(cardEl); return; }

    cells[d.idx] = 0;
    renderCell(d.idx);
    o.got += 1;
    if (o.pipsEl) o.pipsEl.textContent = ' （已交 ' + o.got + '/' + o.need + '）';
    const c = centerOf(cardEl);

    if (o.got >= o.need){
      completeOrder(o);
    } else {
      floatText(c.x, c.y - 10, '交付 1 个', 'ok');
      sfx.deliver();
    }
  }
  function completeOrder(o){
    if (o.dead) return;
    o.dead = true;
    totalOrders += 1;
    stageOrders += 1;
    const gain = rewardOf(o);
    coins += gain;
    score += gain;
    updateHUD();
    updateStageBar();
    bump(coinChipEl);
    const c = centerOf(o.el);
    floatText(c.x, c.y - 6, '+' + gain + ' 🪙', 'coin');
    o.el.classList.remove('urgent');
    o.el.classList.add('done');
    sfx.done();

    const g = gameId;
    if (stageOrders >= stage().goal){
      orders.forEach(function(x){ x.dead = true; });   // 达成目标后不再接受交付
      bump(stageBarEl);
      setTimeout(function(){ if (g === gameId && phase === 'play') stageClear(); }, 520);
      return;
    }
    recycleOrder(o, 430);
  }
  /* 订单超时：不结束游戏，改为扣分 + 失去一颗爱心 */
  function expireOrder(o){
    if (o.dead || phase !== 'play') return;
    o.dead = true;
    const penalty = PENALTY_PER_LV * o.level * o.need;
    score -= penalty;
    hearts = Math.max(0, hearts - 1);
    updateHUD();
    renderHearts(hearts);
    const c = centerOf(o.el);
    floatText(c.x, c.y - 8, '-' + penalty + ' ⭐', 'penalty');
    floatText(c.x, c.y + 16, '-1 ❤️', 'penalty small');
    o.el.classList.remove('urgent');
    o.el.classList.remove('expired');
    void o.el.offsetWidth;
    o.el.classList.add('expired');
    sfx.expire();
    if (hearts <= 0){ gameOver(); return; }
    recycleOrder(o, 620);
  }
  /* 把订单卡回收成一张新订单（DOM 位置不变） */
  function recycleOrder(o, delay){
    const g = gameId;
    const idx = orders.indexOf(o);
    if (idx > -1) orders.splice(idx, 1);
    setTimeout(function(){
      if (g !== gameId || phase !== 'play') return;
      o.el.classList.remove('done', 'expired');
      fillOrder(o);
      o.el.classList.add('in');
      orders.push(o);
      setTimeout(function(){ if (g === gameId) o.el.classList.remove('in'); }, 450);
    }, delay);
  }

  /* ================= 拖拽 ================= */
  function positionGhost(x, y){
    ghostEl.style.left = x + 'px';
    ghostEl.style.top = y + 'px';
  }
  function hitTest(x, y){
    const el = document.elementFromPoint(x, y);
    if (!el) return null;
    const card = el.closest('.order-card');
    if (card && !card.classList.contains('done') && !card.classList.contains('expired')) return { kind:'order', el: card };
    const cell = el.closest('.cell');
    if (cell) return { kind:'cell', index: Number(cell.dataset.index) };
    return null;
  }
  function clearHover(){
    cellEls.forEach(function(c){ c.classList.remove('hover'); });
    orders.forEach(function(o){ o.el.classList.remove('hover'); });
  }
  function applyHover(hit){
    clearHover();
    if (!hit) return;
    if (hit.kind === 'cell') cellEls[hit.index].classList.add('hover');
    else hit.el.classList.add('hover');
  }
  function onPointerDown(e){
    if (phase !== 'play' || drag) return;
    const cellEl = e.target.closest ? e.target.closest('.cell') : null;
    if (!cellEl) return;
    const idx = Number(cellEl.dataset.index);
    const lv = cells[idx];
    if (!lv) return;
    e.preventDefault();

    const r = cellEl.getBoundingClientRect();
    drag = { idx: idx, lv: lv, fromEl: cellEl, hit: null };
    ghostEl.style.width = r.width + 'px';
    ghostEl.style.height = r.height + 'px';
    ghostEl.style.fontSize = Math.round(r.width * 0.62) + 'px';
    ghostEl.textContent = levelInfo(lv).emoji;
    ghostEl.classList.add('on');
    positionGhost(e.clientX, e.clientY);
    cellEl.classList.add('dragging');
    sfx.pick();

    window.addEventListener('pointermove', onPointerMove, { passive:false });
    window.addEventListener('pointerup', onPointerUp);
    window.addEventListener('pointercancel', onPointerUp);
  }
  function onPointerMove(e){
    if (!drag) return;
    e.preventDefault();
    positionGhost(e.clientX, e.clientY);
    const hit = hitTest(e.clientX, e.clientY);
    drag.hit = hit;
    applyHover(hit);
  }
  function onPointerUp(e){
    if (!drag) return;
    window.removeEventListener('pointermove', onPointerMove);
    window.removeEventListener('pointerup', onPointerUp);
    window.removeEventListener('pointercancel', onPointerUp);

    ghostEl.classList.remove('on');
    clearHover();
    drag.fromEl.classList.remove('dragging');

    const d = drag;
    drag = null;

    const hit = hitTest(e.clientX, e.clientY);
    if (!hit) return;

    if (hit.kind === 'order'){
      tryDeliver(d, hit.el);
      return;
    }
    const to = hit.index;
    if (to === d.idx) return;

    const target = cells[to];
    if (target === 0){
      cells[d.idx] = 0;
      cells[to] = d.lv;
      renderCell(d.idx);
      renderCell(to, 'spawn');
      sfx.pick();
    } else if (target === d.lv && d.lv < MAX_LV){
      mergeInto(d.idx, to);
    } else {
      badCell(cellEls[to]);
    }
  }
  function stopDrag(){
    if (!drag) return;
    window.removeEventListener('pointermove', onPointerMove);
    window.removeEventListener('pointerup', onPointerUp);
    window.removeEventListener('pointercancel', onPointerUp);
    if (drag.fromEl) drag.fromEl.classList.remove('dragging');
    drag = null;
    ghostEl.classList.remove('on');
    clearHover();
  }

  /* ================= 主循环 ================= */
  function loop(ts){
    if (phase !== 'play') return;
    if (ts - lastSpawn >= stage().spawn){
      lastSpawn = ts;
      if (spawnItem(true)) sfx.pick();
    }
    updateOrders(performance.now());
    if (phase !== 'play') return;
    rafId = requestAnimationFrame(loop);
  }

  /* ================= 关卡流程 ================= */
  /* 重置台面与订单（金币 / 总分跨关卡保留） */
  function setupStage(){
    gameId += 1;
    const g = gameId;
    cancelAnimationFrame(rafId);
    stopDrag();
    const st = stage();

    cells = new Array(TOTAL).fill(0);
    orders = [];
    hearts = st.hearts;
    stageOrders = 0;
    stageStartScore = score;
    stageStartCoins = coins;
    orderSeq = 0;
    orderListEl.innerHTML = '';
    cellEls.forEach(function(c){ c.classList.remove('dragging', 'hover', 'bad'); });
    for (let i = 0; i < TOTAL; i++) renderCell(i);

    buildHearts(st.hearts);
    updateHUD();
    updateStageBar();

    ORDER_START_DELAYS.forEach(function(d){ newOrder(d); });

    const empties = emptyIndexes();
    for (let i = empties.length - 1; i > 0; i--){
      const j = randInt(i + 1);
      const t = empties[i]; empties[i] = empties[j]; empties[j] = t;
    }
    empties.slice(0, START_ITEMS).forEach(function(idx, n){
      cells[idx] = (n % 4 === 3) ? 2 : 1;
      setTimeout(function(){ if (g === gameId) renderCell(idx, 'spawn'); }, n * 45);
    });

    lastSpawn = performance.now();
  }

  function goPlay(){
    phase = 'play';
    hideScreens();
    document.body.classList.remove('phase-home');
    rafId = requestAnimationFrame(loop);
  }
  function startRun(stageNo){
    stageIndex = Math.max(0, Math.min((stageNo || 1) - 1, STAGES.length - 1));
    coins = 0;
    score = 0;
    totalOrders = 0;
    setupStage();
    goPlay();
    sfx.pick();
  }
  function nextStage(){
    if (isLastStage()){ goHome(); return; }
    stageIndex += 1;
    setupStage();
    goPlay();
  }
  function retryStage(){
    score = stageStartScore;
    coins = stageStartCoins;
    setupStage();
    goPlay();
  }
  function goHome(){
    cancelAnimationFrame(rafId);
    stopDrag();
    stageIndex = Math.min(unlockedStage - 1, STAGES.length - 1);
    phase = 'home';
    setupStage();
    hideScreens();
    homeEl.classList.add('show');
    document.body.classList.add('phase-home');
    updateHomeUI();
  }

  /* 爱心用完 → 打烊（可重试本关） */
  function gameOver(){
    if (phase !== 'play') return;
    phase = 'over';
    cancelAnimationFrame(rafId);
    stopDrag();
    $('ovStage').textContent = stageIndex + 1;
    $('ovOrders').textContent = stageOrders + '/' + stage().goal;
    $('ovCoins').textContent = coins;
    $('ovScore').textContent = score;
    overlayEl.classList.add('show');
    sfx.over();
  }
  /* 订单目标达成 → 过关 */
  function stageClear(){
    if (phase !== 'play') return;
    phase = 'stageClear';
    cancelAnimationFrame(rafId);
    stopDrag();
    const last = isLastStage();
    if (stageIndex + 1 >= unlockedStage){
      unlockedStage = Math.min(stageIndex + 2, STAGES.length);
      saveUnlocked(unlockedStage);
    }
    $('clearTitle').textContent = last ? '🏆 全部通关啦！' : '🎉 第 ' + (stageIndex + 1) + ' 关完成！';
    $('clearMsg').textContent = last
      ? '整个小镇都尝到了你的甜蜜魔法，你就是传说中的甜点大师！'
      : '顾客们都心满意足地捧着甜点回家啦～';
    $('clearOrders').textContent = Math.min(stageOrders, stage().goal);
    $('clearScore').textContent = score - stageStartScore;
    $('clearHearts').textContent = hearts;
    $('nextBtn').textContent = last ? '回到首页 🏠' : '进入第 ' + (stageIndex + 2) + ' 关 ▶';
    clearScreenEl.classList.add('show');
    sfx.clear();
  }

  /* ================= 暂停 ================= */
  function pauseGame(){
    if (phase !== 'play') return;
    phase = 'paused';
    pausedAt = performance.now();
    cancelAnimationFrame(rafId);
    stopDrag();
    $('pauseStage').textContent = stageIndex + 1;
    $('pauseOrders').textContent = stageOrders + '/' + stage().goal;
    $('pauseScore').textContent = score;
    pauseScreenEl.classList.add('show');
    sfx.pick();
  }
  function resumeGame(){
    if (phase !== 'paused') return;
    const now = performance.now();
    const shift = now - pausedAt;          // 暂停期间的时间不算进订单倒计时
    orders.forEach(function(o){ o.deadline += shift; });
    lastSpawn = now;
    phase = 'play';
    pauseScreenEl.classList.remove('show');
    rafId = requestAnimationFrame(loop);
    sfx.pick();
  }
  function togglePause(){
    if (phase === 'play') pauseGame();
    else if (phase === 'paused') resumeGame();
  }

  /* ================= 事件绑定 ================= */
  boardEl.addEventListener('pointerdown', onPointerDown);
  $('startBtn').addEventListener('click', function(){ startRun(unlockedStage); });
  $('restartRunBtn').addEventListener('click', function(){
    unlockedStage = 1;
    saveUnlocked(1);
    startRun(1);
  });
  $('nextBtn').addEventListener('click', nextStage);
  $('retryBtn').addEventListener('click', retryStage);
  $('clearHomeBtn').addEventListener('click', goHome);
  $('homeBtn').addEventListener('click', goHome);
  $('pauseHomeBtn').addEventListener('click', goHome);
  $('resumeBtn').addEventListener('click', resumeGame);
  pauseBtn.addEventListener('click', togglePause);
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape') togglePause();
  });
  document.addEventListener('visibilitychange', function(){
    if (document.hidden) pauseGame();
  });
  window.addEventListener('contextmenu', function(e){
    if (e.target.closest && e.target.closest('.board, .order-list')) e.preventDefault();
  });

  /* ================= 启动 ================= */
  buildBoard();
  buildChain();
  buildDeco();
  phase = 'home';
  stageIndex = Math.min(unlockedStage - 1, STAGES.length - 1);
  setupStage();          // 首页背后的静态场景（主循环未启动）
  hideScreens();
  homeEl.classList.add('show');
  updateHomeUI();
})();
</script>

</body>
</html>
